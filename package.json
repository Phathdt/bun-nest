{
  "name": "bun-nest-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "format": "prettier --write .",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:e2e": "bun run db:up && bun run backend:prisma:migrate:deploy && bun run backend:prisma:seed && turbo test:e2e --filter=e2e",
    "typecheck": "turbo typecheck",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "backend:dev": "turbo dev --filter=@bun-nest/backend",
    "backend:build": "turbo build --filter=@bun-nest/backend",
    "backend:lint": "turbo lint --filter=@bun-nest/backend",
    "backend:test": "turbo test --filter=@bun-nest/backend",
    "backend:test:unit": "turbo test:unit --filter=@bun-nest/backend",
    "backend:test:integration": "turbo test:integration --filter=@bun-nest/backend",
    "backend:typecheck": "turbo typecheck --filter=@bun-nest/backend",
    "backend:prisma:generate": "turbo prisma:generate --filter=@bun-nest/backend",
    "backend:prisma:migrate": "turbo prisma:migrate --filter=@bun-nest/backend",
    "backend:prisma:migrate:deploy": "turbo prisma:migrate:deploy --filter=@bun-nest/backend",
    "backend:prisma:seed": "turbo prisma:seed --filter=@bun-nest/backend",
    "web:dev": "turbo dev --filter=web",
    "web:build": "turbo build --filter=web",
    "web:lint": "turbo lint --filter=web",
    "web:preview": "cd apps/web && bun run preview",
    "e2e:test": "turbo test:e2e --filter=e2e",
    "e2e:test:headed": "cd apps/e2e && bun run test:e2e:headed",
    "e2e:install:browsers": "cd apps/e2e && bun run install:browsers"
  },
  "devDependencies": {
    "oxlint": "^1.64.0",
    "prettier": "^3.8.3",
    "turbo": "^2.9.12",
    "typescript": "^5.8.0"
  }
}
