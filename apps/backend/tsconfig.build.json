{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/backend",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "prisma.config.ts"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.integration.spec.ts",
    "test/**/*.ts",
    "vitest.config.ts",
    "vitest.integration.config.ts"
  ]
}
