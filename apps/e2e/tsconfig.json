{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@config/*": ["config/*"],
      "@page-objects/*": ["page-objects/*"],
      "@support/*": ["tests/support/*"],
      "@utils/*": ["utils/*"]
    }
  },
  "include": ["config/**/*.ts", "page-objects/**/*.ts", "tests/**/*.ts", "utils/**/*.ts"]
}
