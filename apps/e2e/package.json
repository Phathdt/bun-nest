{
  "name": "e2e",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "test:e2e": "mkdir -p test-results && cucumber-js --config .cucumber.cjs",
    "test:e2e:headed": "HEADLESS=false cucumber-js --config .cucumber.cjs",
    "test:e2e:smoke": "cucumber-js --config .cucumber.cjs --tags @smoke",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install chromium",
    "clean": "rm -rf test-results"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.8.2",
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.12.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
