{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["../../dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:unit": {
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "cache": false,
      "outputs": []
    },
    "test:e2e": {
      "cache": false,
      "outputs": ["test-results/**"]
    },
    "prisma:generate": {
      "cache": false,
      "outputs": ["src/generated/**"]
    },
    "prisma:migrate": {
      "cache": false,
      "outputs": []
    },
    "prisma:migrate:deploy": {
      "cache": false,
      "outputs": []
    },
    "prisma:seed": {
      "cache": false,
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    }
  }
}
